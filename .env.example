# motivational-reel-pipeline - example configuration
#
# Copy to .env for LOCAL DEVELOPMENT ONLY:  cp .env.example .env
# .env is gitignored. This file must only ever contain non-secret placeholders.
#
# Secrets (Meta access tokens, app secret, model API keys) are NEVER stored here.
# They live in AWS Secrets Manager and are referenced by ARN via META_SECRET_ARN.

# ---------------------------------------------------------------- core
AWS_REGION=ap-southeast-2
ENVIRONMENT=dev                       # dev | staging | prod | test
LOG_LEVEL=INFO                        # DEBUG | INFO | WARN | ERROR

# Which provider implementations to bind. `mock` requires no AWS credentials.
PROVIDER_MODE=mock                    # mock | bedrock

# ---------------------------------------------------------------- volume
DAILY_TARGET=5                        # reels generated per day (grow to 20-30)
MAX_DAILY_PUBLISHES_PER_PLATFORM=5

# ---------------------------------------------------------------- publishing
# dry_run        - produce every asset and payload, call no Meta endpoint
# manual_approval- render + park in review queue, publish only after approval
# auto_publish   - publish automatically (also requires ALLOW_PRODUCTION_PUBLISH=true)
PUBLISH_MODE=dry_run
ENABLED_PLATFORMS=instagram,facebook

# Hard guard. Publishing to Meta is refused unless this is literally "true"
# AND ENVIRONMENT=prod AND PUBLISH_MODE is manual_approval|auto_publish.
ALLOW_PRODUCTION_PUBLISH=false

# Halts all scheduled publishing without deleting assets. In AWS this is read
# from SSM Parameter Store at /mrp/<env>/kill-switch and overrides this value.
KILL_SWITCH_ENABLED=false

# ---------------------------------------------------------------- creative
# overlay      - AI draws illustration only, exact quote drawn by FFmpeg (default, safest)
# hybrid       - AI may suggest lettering, FFmpeg still draws the authoritative quote
# embedded_ai  - trust generated typography (NOT recommended, spelling is unreliable)
QUOTE_RENDER_MODE=overlay
REEL_DURATION_SECONDS=14              # clamped to 10-18
BRAND_HANDLE=                         # e.g. @yourhandle - blank disables the attribution line
QUOTE_MIN_WORDS=6
QUOTE_MAX_WORDS=18
QUOTE_DEDUPE_WINDOW_DAYS=90

# ---------------------------------------------------------------- models
# Left blank on purpose. Bedrock model availability differs per region and per
# account. Verify with: aws bedrock list-foundation-models --region ap-southeast-2
# Never hardcode a model id that may not be enabled in your account.
BEDROCK_TEXT_MODEL_ID=
BEDROCK_IMAGE_MODEL_ID=
BEDROCK_REGION=                       # optional override, defaults to AWS_REGION

# ---------------------------------------------------------------- meta
# Verify the current version against official Meta documentation at setup time.
META_GRAPH_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
INSTAGRAM_ACCOUNT_ID=                 # Instagram Professional account id (numeric)
FACEBOOK_PAGE_ID=                     # Facebook Page id (numeric)
META_SECRET_ARN=                      # arn:aws:secretsmanager:...:secret:mrp/meta-xxxxxx
INSTAGRAM_SHARE_TO_FEED=true

# ---------------------------------------------------------------- music
# owned_licensed - use MUSIC_S3_URI, requires MUSIC_LICENSE_REFERENCE
# silent         - render a silent AAC track (default, always safe)
# Meta's in-app music library CANNOT be selected programmatically or reused here.
MUSIC_MODE=silent
MUSIC_S3_URI=
MUSIC_LICENSE_REFERENCE=
MUSIC_VOLUME_DB=-18

# ---------------------------------------------------------------- scheduling
SCHEDULE_TIMEZONE=Pacific/Auckland
# Comma separated local-time windows in which publishing may occur.
PUBLISH_WINDOWS=07:00-09:30,12:00-13:30,18:00-21:00

# ---------------------------------------------------------------- reliability
MAX_GENERATION_ATTEMPTS=3
MAX_PUBLISH_ATTEMPTS=4
MAX_CONTAINER_POLL_ATTEMPTS=20
CONTAINER_POLL_INTERVAL_SECONDS=15
PRESIGNED_URL_TTL_SECONDS=3600
IMAGE_GENERATION_CONCURRENCY=2
RENDER_CONCURRENCY=2
PUBLISH_CONCURRENCY=1

# ---------------------------------------------------------------- cost guard
COST_GUARD_ENABLED=true
DAILY_COST_BUDGET_USD=5
MONTHLY_COST_BUDGET_USD=100

# ---------------------------------------------------------------- storage (set by CDK outputs)
ASSETS_BUCKET=
TABLE_NAME=
QUOTE_FONT_PATH=                      # optional absolute path override for the handwritten font
